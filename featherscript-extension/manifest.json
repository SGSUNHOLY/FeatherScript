{
  "manifest_version": 3,
  "name": "FeatherScript - Roblox Studio Agent",
  "version": "2.0.1",
  "description": "FeatherScript connects supported AI chats to Roblox Studio through a local bridge.",
  "permissions": [
    "storage",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://chat.deepseek.com/*",
    "https://deepseek.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://www.kimi.ai/*",
    "https://kimi.ai/*",
    "https://chat.z.ai/*",
    "https://chat.qwen.ai/*",
    "https://arena.ai/*",
    "https://www.meta.ai/*",
    "https://meta.ai/*",
    "https://c.vani.ai/*",
    "https://www.notion.so/*",
    "https://notion.so/*",
    "https://app.notion.com/*",
    "https://aistudio.xiaomimimo.com/*",
    "https://www.genspark.ai/*",
    "https://genspark.ai/*",
    "http://127.0.0.1/*",
    "ws://127.0.0.1/*",
    "https://aistudio.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/feather-mark.png",
    "48": "assets/feather-mark.png",
    "128": "assets/feather-mark.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FeatherScript",
    "default_icon": {
      "16": "assets/feather-mark.png",
      "48": "assets/feather-mark.png",
      "128": "assets/feather-mark.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "https://www.kimi.ai/*",
        "https://kimi.ai/*",
        "https://chat.z.ai/*",
        "https://chat.qwen.ai/*",
        "https://arena.ai/*",
        "https://www.meta.ai/*",
        "https://meta.ai/*",
        "https://c.vani.ai/*",
        "https://www.notion.so/*",
        "https://notion.so/*",
        "https://app.notion.com/*",
        "https://aistudio.xiaomimimo.com/*",
        "https://www.genspark.ai/*",
        "https://genspark.ai/*",
        "https://aistudio.google.com/*"
      ],
      "js": [
        "core/keepawake.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "core/theme-presets.js",
        "core/theme-motion.js",
        "core/theme.js",
        "core/config.js",
        "core/parser.js",
        "providers/deepseek.js",
        "core/commands.js",
        "core/provider-status.js",
        "core/task-policy.js",
        "core/cowork.js",
        "core/audio-ui.js",
        "core/projects.js",
        "core/projects-ui.js",
        "core/workflow.js",
        "core/server-status.js",
        "core/main.js"
      ],
      "css": [
        "overlay.css",
        "theme-presets.css",
        "controller-polish.css",
        "workflow.css",
        "controller-layout.css",
        "theme-identities.css",
        "controller-skin.css",
        "theme-motion.css",
        "audio.css",
        "projects.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "providers/chatgpt-cm.js"
      ],
      "world": "MAIN",
